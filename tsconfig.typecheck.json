{
    // The config the `typecheck` script uses. The editor configs check the tests and the examples
    // too, which is useful while writing them but drowns the source: those two carry well over
    // a thousand findings between them, so a regression in src would never be noticed.
    //
    // This one is scoped to the shipped source, and it is the number that has to stay at zero.
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "allowJs": true,
        "checkJs": true,
        // Turned on one flag at a time, each landing with the count back at zero rather than as
        // one unreadable pile; noImplicitAny was the last. That one also gives JSDoc's `object`
        // its real meaning, without it TypeScript reads it as `any`.
        "strict": true,
        "noEmit": true,
        // the declaration files shipped by the dependencies are their problem, not ours
        "skipLibCheck": true,
        "types": ["node"],
        "paths": {
            "fulmine.js": ["./src/types.d.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "coverage"]
}
