{
    "name": "fulmine.js",
    "version": "5.1.2",
    "description": "Drop-in Express 5 replacement on uWebSockets.js. Your existing middleware keeps working.",
    "main": "src/index.js",
    "bin": {
        "fulmine": "src/cli.js",
        "fulmine.js": "src/cli.js"
    },
    "scripts": {
        "test": "node tests/index.js",
        "test:unit": "node --test \"tests/unit/*.test.js\"",
        "test:types": "tsd --files tests/types/*.test-d.ts",
        "test:express": "node tools/express-suite.js",
        "benchmark:compare": "node benchmark/run.js",
        "cover": "npm run cover:unit && npm run cover:report",
        "cover:unit": "nyc --silent npm run test",
        "cover:report": "nyc report --reporter=html",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "release": "release-it",
        "typecheck": "tsc -p tsconfig.typecheck.json",
        "benchmark:ab": "node benchmark/ab.js",
        "benchmark:profile": "node benchmark/profile.js",
        "release:local": "node tools/release-local.js"
    },
    "engines": {
        "node": ">=22"
    },
    "files": [
        "src",
        "LICENSE",
        "NOTICE",
        "EXPRESS_LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nigrosimone/fulmine.js.git"
    },
    "keywords": [
