    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch current test",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test", "--", "${file}"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch all test",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "test"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
